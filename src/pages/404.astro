---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import '../styles/pages/notes.css' // holds .page-actions (the 404 has no stylesheet of its own)
---
<Base title="Page not found" description="This page doesn't exist on lucasbianco.com. Head back to the home page or browse Lucas Bianco's projects." noindex>
  <PageHeader title="Page not found" measure="404" lede="That page doesn't exist, or it moved. The old robotics page is now split into project pages.">
    <p class="actions page-actions">
      <a class="button" href="/">Go to the home page</a>
      <a class="button button-outline" href="/projects/">See projects</a>
    </p>
  </PageHeader>
</Base>
