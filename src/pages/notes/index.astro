---
// Notes: short write-ups about what I learned building things. Newest first.
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageHeader from '../../components/PageHeader.astro'
import Icon from '../../components/Icon.astro'
import '../../styles/pages/notes.css'

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const projects = await getCollection('projects')
const projectFor = (slug?: string) => slug ? projects.find((p) => p.id === slug || p.id === `${slug}/index`) : undefined
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const minutes = (body = '') => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220))
---
<Base
  title="Notes"
  description="Notes by Lucas Bianco on what building things actually taught him: real test results, mistakes he caught, and what he would do differently next time."
>
  <PageHeader
    title="Notes"
    measure={`${notes.length} ${notes.length === 1 ? 'note' : 'notes'}`}
    lede="Write-ups on what actually happened when I tested my own projects. Mostly the parts that didn't go to plan."
  />

  <section class="notes-section">
    <div class="frame">
      <ol class="notes-list">
        {notes.map((n) => {
          const related = projectFor(n.data.project)
          return (
            <li>
              <article class="card card-hover note-card">
                <p class="note-meta">
                  <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
                  <span>{minutes(n.body)} min read</span>
                </p>
                <h2 class="note-card-title"><a href={`/notes/${n.id}/`}>{n.data.title}</a></h2>
                <p class="note-card-summary">{n.data.summary}</p>
                <div class="note-card-foot">
                  {related && <a class="badge badge-accent note-project" href={`/projects/${n.data.project}/`}>{related.data.title}</a>}
                  <a class="button button-outline button-sm" href={`/notes/${n.id}/`} aria-label={`Read: ${n.data.title}`}>Read note</a>
                </div>
              </article>
            </li>
          )
        })}
      </ol>
      <p class="small muted notes-rss"><Icon name="rss" />Want new ones? There's an <a href="/notes/rss.xml">RSS feed</a>.</p>
    </div>
  </section>
</Base>
