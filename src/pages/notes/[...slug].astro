---
// One note, rendered as prose with BlogPosting structured data.
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageHeader from '../../components/PageHeader.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { site } from '../../data/site'
import '../../styles/pages/notes.css'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}

const { note } = Astro.props
const { Content } = await render(note)
const { title, summary, date, project } = note.data

const iso = date.toISOString()
const pretty = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const minutes = Math.max(1, Math.round((note.body ?? '').split(/\s+/).filter(Boolean).length / 220))
const url = new URL(`/notes/${note.id}/`, site.url).href

// link the related project only if that project page exists
const related = project
  ? (await getCollection('projects')).find((p) => p.id === project || p.id === `${project}/index`)
  : undefined

// newer / older neighbours
const all = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const i = all.findIndex((n) => n.id === note.id)
const newer = i > 0 ? all[i - 1] : undefined
const older = i < all.length - 1 ? all[i + 1] : undefined

const jsonLd = {
  '@type': 'BlogPosting',
  image: `${site.url}/og-image.png`,
  '@id': `${url}#post`,
  headline: title,
  description: summary,
  datePublished: iso,
  dateModified: iso,
  url,
  mainEntityOfPage: url,
  author: { '@id': `${site.url}/#lucas` },
  publisher: { '@id': `${site.url}/#lucas` },
  isPartOf: { '@id': `${site.url}/#site` },
  inLanguage: 'en-US',
}
---
<Base title={title} description={summary} type="article" publishedTime={iso} jsonLd={jsonLd}>
  <article class="note">
    <PageHeader title={title} crumbs={[{ href: '/', label: 'Home' }, { href: '/notes/', label: 'Notes' }]}>
      <p class="note-meta note-byline">
        <time datetime={iso.slice(0, 10)}>{pretty}</time>
        <span>{minutes} min read</span>
        {related && <a class="badge badge-accent note-project" href={`/projects/${project}/`}>{related.data.title}</a>}
      </p>
    </PageHeader>

    <div class="frame note-body">
      <div class="prose note-prose">
        <Content />
      </div>

      {related && (
        <aside class="note-related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="note-aside-title">The project behind this note</h2>
          <ProjectCard project={related} />
        </aside>
      )}

      {(newer || older) && (
        <nav class="note-nav" aria-label="More notes">
          {newer && <a class="card card-hover note-nav-link" href={`/notes/${newer.id}/`}><span class="small muted">Newer note</span>{newer.data.title}</a>}
          {older && <a class="card card-hover note-nav-link note-nav-older" href={`/notes/${older.id}/`}><span class="small muted">Older note</span>{older.data.title}</a>}
        </nav>
      )}
      <p class="small muted note-all"><a href="/notes/">All notes</a></p>
    </div>
  </article>
</Base>
