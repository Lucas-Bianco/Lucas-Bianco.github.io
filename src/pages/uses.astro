---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Figure from '../components/Figure.astro'
import Icon from '../components/Icon.astro'
import '../styles/pages/uses.css'

import deskSetup from '../assets/photos/uses/desk-setup.jpg'

// Each item: name, one honest line on why/how. todo = what Lucas still needs to fill in.
type Item = { name: string; why?: string; todo?: string }
type Group = { id: string; title: string; icon: 'cube' | 'wrench' | 'code' | 'spark' | 'file'; intro?: string; items: Item[] }

const groups: Group[] = [
  {
    id: 'making',
    icon: 'cube',
    title: 'Making',
    intro: 'Most of what I design ends up on one of these two printers first.',
    items: [
      { name: 'Bambu Lab X2D with AMS', why: 'The bigger of the two. Multi-material prints run through the AMS.', todo: 'what you print on the X2D vs the A1' },
      { name: 'Bambu Lab A1 with AMS', why: 'The second printer, also with an AMS, so two jobs can run at once.' },
      { name: 'Bambu Studio', why: 'My slicer for both printers. Plates, supports, and filament changes all get set up here.' },
      { name: 'IKEA SKÅDIS pegboard', why: 'Fit testing for printed hooks and holders. The hole spacing is fixed, so a bad tolerance shows up right away.' },
      { name: 'Gridfinity', why: 'The bin system in my drawers. A standard grid is a free tolerance check: if a print drops in cleanly, my dimensions were right.' },
    ],
  },
  {
    id: 'cad',
    icon: 'file',
    title: 'CAD and design software',
    intro: 'I learned most of these in the Engineering Technology program.',
    items: [
      { name: 'SolidWorks', why: 'My main CAD tool for parts and assemblies, robot parts included.' },
      { name: 'AutoCAD', why: '2D drawings and layouts. I hold the Autodesk Certified User certification in it.' },
      { name: 'Revit', why: 'Building and architectural models.', todo: 'what you made in Revit' },
      { name: 'Fusion', why: 'Quick parts at home when I want CAD and CAM in one place.', todo: 'confirm how you use Fusion' },
      { name: 'Multisim', why: 'Simulating circuits before wiring anything real.' },
      { name: 'CorelDRAW', why: 'Vector files for the laser cutter.', todo: 'confirm' },
      { name: 'Tinkercad', why: 'Where I started. Still the fastest way to sketch a simple idea.', todo: 'confirm' },
    ],
  },
  {
    id: 'computers',
    icon: 'spark',
    title: 'Computers',
    items: [
      { name: 'Desktop with an RTX 5070 Ti', why: 'CAD work, and the GPU that runs my local AI models for Jarvis. It sleeps until Jarvis wakes it over the network.', todo: 'CPU, RAM, storage, case' },
      { name: 'Six Raspberry Pi 5 (8 GB)', why: 'What Jarvis is built for: the wall kiosk, the core services, and the rest of my home system. The kiosk Pi is live first.' },
      { name: 'Raspberry Pi Touch Display 2', why: 'The touch panel on the Jarvis kiosk for quick taps without a keyboard.' },
      { name: 'Acer 24" monitor, mounted vertically', why: 'The Jarvis wall display. Vertical fits a day plan and a project list much better than wide.' },
    ],
  },
  {
    id: 'code',
    icon: 'code',
    title: 'Code',
    items: [
      { name: 'Python', why: 'My default language. Backends, computer vision, backtests, scripts.' },
      { name: 'TypeScript', why: 'Front ends, like the React app for my Pokémon card scanner.' },
      { name: 'Astro', why: 'This site and the HexaFlow site. Static pages that load fast.' },
      { name: 'Svelte', why: 'The Jarvis HUD. Small and quick on a Raspberry Pi.' },
      { name: 'FastAPI', why: 'The API layer for Jarvis and the card scanner.' },
      { name: 'Ollama', why: 'Runs local models on my desktop GPU, so the private Jarvis jobs never leave my own hardware.' },
      { name: 'Tailscale', why: 'Lets my phone reach Jarvis from anywhere without opening anything to the internet.' },
      { name: 'Git and GitHub', why: 'Version control for everything, so I can always get back to the version that worked.' },
    ],
  },
  {
    id: 'shop',
    icon: 'wrench',
    title: 'Shop tools',
    intro: 'I hold NC3/Starrett Precision Measurement certifications for tape and rule and for slide calipers.',
    items: [
      { name: 'Slide calipers', why: 'Measuring parts and printed fits before I commit to a dimension in CAD.', todo: 'brand and model' },
      { name: 'Tape measure and steel rule', why: 'Bigger stock and layout work in the shop.', todo: 'brand and model' },
      { name: 'Other shop tools', todo: 'list the tools you actually reach for (school shop or home)' },
    ],
  },
  {
    id: 'camera',
    icon: 'spark',
    title: 'Camera gear',
    items: [
      { name: 'Camera', todo: 'body, lenses, and what you shoot with most' },
      { name: 'Video and editing', todo: 'editing software and any audio or stabilizer gear' },
    ],
  },
]

const description =
  'The tools Lucas Bianco uses: Bambu printers, SolidWorks and other CAD software, an RTX 5070 Ti desktop, six Raspberry Pi 5s, his code stack, and shop tools.'
---
<Base title="My setup" description={description}>
  <PageHeader
    title="My setup"
    crumbs={[{ href: '/', label: 'Home' }]}
    measure="last updated October 2026"
    lede="The hardware, software, and tools I actually use, and one honest line on why."
  />

  <section class="section uses-hero">
    <div class="frame">
      <div class="card uses-photo-card">
        <Figure
          src={deskSetup}
          alt="Placeholder for a photo of Lucas's desk setup with two Bambu 3D printers, a SKÅDIS pegboard wall, and a vertical monitor"
          eager
          sizes="(max-width: 1216px) 100vw, 1216px"
        />
        <p class="small"><span class="todo">Photo to add: the desk with both printers, the pegboard wall and the vertical Jarvis screen</span></p>
      </div>
      <nav class="uses-toc" aria-label="Sections on this page">
        <ul>
          {groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  {groups.map((g, n) => (
    <section class:list={['section', n % 2 === 0 && 'section-tint']} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="frame">
        <div class="section-head">
          <h2 id={`${g.id}-h`}>{g.title}</h2>
          {g.intro && <p>{g.intro}</p>}
        </div>
        <ul class="card-grid uses-grid">
          {g.items.map((i) => (
            <li class="card uses-item">
              <h3 class="card-title"><Icon name={g.icon} />{i.name}</h3>
              {(i.why || i.todo) && (
                <p class="muted small">
                  {i.why}
                  {i.todo && <> <span class="todo">{i.todo}</span></>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
