---
// /projects/ : every project as a card, engineering and robotics first,
// with category filter buttons (progressive enhancement: no JS = all cards shown).
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageHeader from '../../components/PageHeader.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { categoryLabel } from '../../data/labels'
import '../../styles/pages/projects.css'

const categoryOrder = ['engineering', 'robotics', 'making', 'software'] as const
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category) ||
    a.data.order - b.data.order,
)
const present = categoryOrder.filter((c) => projects.some((p) => p.data.category === c))
const count = `${projects.length} project${projects.length === 1 ? '' : 's'}`
---
<Base
  title="Projects"
  description="Lucas Bianco's projects: a NASA HUNCH nanolab, competition robots, CAD and 3D printing, and software he builds solo, each written up with problem, testing and results."
>
  <PageHeader
    title="Projects"
    measure={count}
    lede="Engineering and robotics first: a NASA HUNCH payload, competition robots, and things I designed and printed. Then the software I build on my own time."
  />

  <section class="projects-index" aria-label="All projects">
    <div class="frame">
      <p class="projects-intro muted">
        Every write-up follows the same order: the problem, what I built, how it works, how I tested it,
        the results, and what I learned. Team projects also say exactly what my part was.
      </p>

      <div class="filters projects-filters" role="group" aria-label="Filter projects by category" data-filters hidden>
        <button type="button" data-category="all" aria-pressed="true">All</button>
        {present.map((c) => (
          <button type="button" data-category={c} aria-pressed="false">{categoryLabel[c]}</button>
        ))}
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>

      <div class="card-grid">
        {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]')
  const status = document.querySelector<HTMLElement>('[data-filter-status]')
  if (bar) {
    bar.hidden = false
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button')
    const cards = document.querySelectorAll<HTMLElement>('.project-card[data-category]')
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
        let shown = 0
        cards.forEach((card) => {
          const show = cat === 'all' || card.dataset.category === cat
          card.hidden = !show
          if (show) shown++
        })
        if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`
      })
    })
  }
</script>
