---
// /projects/<slug>/ : one project write-up. Content comes from
// src/content/projects/<slug>/index.mdx (frontmatter + MDX body).
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import TitleBlock from '../../components/TitleBlock.astro'
import { site } from '../../data/site'
import '../../styles/pages/projects.css'

const categoryLabel: Record<string, string> = {
  engineering: 'Engineering', robotics: 'Robotics', making: 'Making', software: 'Software',
}
const statusLabel = { done: 'Done', ongoing: 'Ongoing', early: 'Early stage' } as const

export async function getStaticPaths() {
  const order = ['engineering', 'robotics', 'making', 'software']
  const all = (await getCollection('projects')).sort(
    (a, b) => order.indexOf(a.data.category) - order.indexOf(b.data.category) || a.data.order - b.data.order,
  )
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }))
}

const { entry, prev, next } = Astro.props
const d = entry.data
const { Content } = await render(entry)

// "2026-03" -> "Mar 2026"
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const fmt = (ym: string) => {
  const [y, m] = ym.split('-')
  return m ? `${months[Number(m) - 1]} ${y}` : y
}
const dates = d.ended ? `${fmt(d.started)} to ${fmt(d.ended)}` : d.status === 'done' ? fmt(d.started) : `${fmt(d.started)} to now`

const facts = [
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Dates', value: dates },
  { label: 'Status', value: statusLabel[d.status] },
  { label: 'Tools', value: d.tools.join(', ') },
  ...d.results.map((r) => ({ label: 'Result', value: r })),
]

// Share image + structured data
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
const cover = await getImage({ src: d.cover, width: 1600, format: 'jpg' })
const pageUrl = new URL(`/projects/${entry.id}/`, site.url).href
const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    name: d.title,
    description: d.summary,
    url: pageUrl,
    creator: { '@id': `${site.url}/#lucas` },
    image: new URL(cover.src, site.url).href,
    dateCreated: d.started,
    keywords: d.tools.join(', '),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
]
---
<Base title={d.title} description={d.summary} image={og.src} type="article" jsonLd={jsonLd}>
  <article class="project">
    <header class="project-hero band-dark">
      <div class="hero-photo">
        <Image src={d.cover} alt={d.coverAlt} layout="full-width" loading="eager" fetchpriority="high" />
      </div>
      <div class="frame hero-text">
        <nav aria-label="Breadcrumb" class="crumbs small">
          <a href="/projects/">Projects</a> <span aria-hidden="true">/</span> <span>{categoryLabel[d.category]}</span>
        </nav>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <div class="hero-facts">
          <TitleBlock items={facts} />
        </div>
      </div>
    </header>

    <div class="project-body">
      <div class="frame">
        <div class="prose project-prose">
          <Content />
        </div>

        {d.links.length > 0 && (
          <div class="project-links">
            <h2 class="links-title">Links</h2>
            <ul class="actions">
              {d.links.map((l, i) => (
                <li><a class:list={['button', i > 0 && 'button-quiet']} href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <nav class="project-nav band-tint" aria-label="More projects">
      <div class="frame project-nav-grid">
        {prev ? (
          <a class="pn pn-prev" href={`/projects/${prev.id}/`}>
            <span class="pn-label small muted">Previous project</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        <a class="pn pn-all" href="/projects/"><span class="pn-label small muted">Back to</span><span class="pn-title">All projects</span></a>
        {next ? (
          <a class="pn pn-next" href={`/projects/${next.id}/`}>
            <span class="pn-label small muted">Next project</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </nav>
  </article>
</Base>
