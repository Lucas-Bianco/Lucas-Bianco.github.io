---
// Experience: the full resume, for colleges and employers.
// Data lives in src/data/experience.ts and src/data/certs.ts.
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import TitleBlock from '../components/TitleBlock.astro'
import Icon from '../components/Icon.astro'
import { site } from '../data/site'
import { jobs, leadership, education, skillGroups, strengths, sports } from '../data/experience'
import { certs, filedCerts, unfiledCerts } from '../data/certs'
import '../styles/pages/experience.css'

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
// "2025-07-26" -> "Jul 2025", "2021" -> "2021". Parsed by hand so time zones can't shift the month.
function fmt(d: string): string {
  const [y, m] = d.split('-')
  return m ? `${months[Number(m) - 1]} ${y}` : y
}
function fmtDay(d: string): string {
  const [y, m, day] = d.split('-')
  return `${months[Number(m) - 1]} ${Number(day)}, ${y}`
}
function range(start: string, end: string | null) {
  return `${fmt(start)} to ${end ? fmt(end) : 'now'}`
}
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1)

const resumeHref = `mailto:${site.email}?subject=${encodeURIComponent('Resume request')}`

const quickFacts = [
  { label: 'Now', value: 'Co-op, Dell Process Development' },
  { label: 'School', value: `${site.schoolShort}, class of ${site.classOf}` },
  { label: 'Program', value: site.program },
  { label: 'GPA', value: site.gpa },
  { label: 'Certifications', value: `${filedCerts.length} on file, ${unfiledCerts.length} more listed` },
  { label: 'Robotics', value: '6 years, VEX captain, FRC co-founder' },
]

const jump = [
  { href: '#work', label: 'Work' },
  { href: '#leadership', label: 'Leadership' },
  { href: '#certifications', label: 'Certifications' },
  { href: '#education', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#strengths', label: 'Strengths' },
]

// Structured data: merges into the Person node Base already outputs (same @id).
const abs = (path: string) => new URL(path, site.url).href
const jsonLd = {
  '@type': 'Person',
  '@id': `${site.url}/#lucas`,
  hasCredential: certs.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    credentialCategory: 'certification',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
    ...(c.date ? { dateCreated: c.date } : {}),
    ...(c.file ? { url: abs(c.file) } : {}),
    ...(c.verify ? { identifier: c.verify.code } : {}),
    competencyRequired: c.covers,
  })),
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: education.school,
    address: { '@type': 'PostalAddress', addressLocality: 'Franklin', addressRegion: 'MA', addressCountry: 'US' },
  },
  affiliation: [
    { '@type': 'Organization', name: 'VEX Robotics team 3236A' },
    { '@type': 'Organization', name: 'Tri-County FRC' },
    { '@type': 'Organization', name: 'NASA HUNCH (HexaFlow team)' },
    { '@type': 'Organization', name: 'SkillsUSA' },
    { '@type': 'Organization', name: 'FreeKicks Special Olympics, Franklin MA' },
  ],
}
---
<Base
  title="Experience"
  description="Lucas Bianco's resume in full: Dell Process Development co-op, robotics captain, NC3 and Autodesk certifications, Engineering Technology GPA 3.95."
  type="profile"
  jsonLd={jsonLd}
>
  <PageHeader
    title="Experience"
    measure="since 2021"
    crumbs={[{ href: '/', label: 'Home' }]}
    lede="I'm an Engineering Technology student who builds things. Right now that means a co-op at Dell's Franklin factory every other week, captaining a VEX team, restarting my school's FRC team, and a cashier job on the side. Here's all of it, with the details."
  >
    <div class="card xp-top stack-md">
      <TitleBlock items={quickFacts} />
      <div class="xp-top-row">
        <p class="muted small">I send my resume by email so it's always the current one. References on request.</p>
        <div class="actions">
          <a class="button" href={resumeHref}><Icon name="mail" />Request my resume</a>
          <a class="button button-outline" href={site.linkedin}><Icon name="linkedin" />LinkedIn</a>
        </div>
      </div>
    </div>
  </PageHeader>

  <nav class="xp-jump" aria-label="Jump to a section">
    <div class="frame">
      <ul>
        {jump.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- WORK -->
  <section class="section" id="work" aria-labelledby="work-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="work-h">Work</h2>
        <p>Paid work, newest first.</p>
      </div>
      <ol class="xp-timeline">
        {jobs.map((j) => (
          <li class="xp-item">
            <article class="card xp-card stack-sm">
              <div class="xp-card-head">
                <h3 class="card-title"><Icon name="briefcase" />{j.role}</h3>
                <span class="badge badge-accent">{range(j.start, j.end)}</span>
              </div>
              <p class="xp-org">{j.org}, {j.location}{j.via && <span class="muted">. {j.via}</span>}</p>
              {j.schedule && <p><span class="badge">{j.schedule}</span></p>}
              <p>{j.summary}</p>
              {(j.bullets.length > 0 || j.todos) && (
                <ul class="xp-bullets">
                  {j.bullets.map((b) => <li>{b}</li>)}
                  {j.todos?.map((t) => <li><span class="todo">{t}</span></li>)}
                </ul>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section class="section section-tint" id="leadership" aria-labelledby="lead-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="lead-h">Leadership and teams</h2>
        <p>Robotics is where I learned to lead: six years of building, coding and running teams, plus a payload that NASA dropped.</p>
      </div>
      <ol class="xp-timeline">
        {leadership.map((r) => (
          <li class="xp-item">
            <article class="card xp-card stack-sm">
              <div class="xp-card-head">
                <h3 class="card-title"><Icon name={r.id === 'freekicks' ? 'spark' : 'robot'} />{r.role}</h3>
                <span class="badge badge-accent">{range(r.start, r.end)}</span>
              </div>
              <p class="xp-org">{r.org}</p>
              <p>{r.summary}</p>
              {(r.bullets.length > 0 || r.todos) && (
                <ul class="xp-bullets">
                  {r.bullets.map((b) => <li>{b}</li>)}
                  {r.todos?.map((t) => <li><span class="todo">{t}</span></li>)}
                </ul>
              )}
              {r.link && <p><a class="button button-outline button-sm" href={r.link.href}>{r.link.label}</a></p>}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="section" id="certifications" aria-labelledby="cert-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="cert-h">Certifications</h2>
        <p>Industry certifications in CAD, mechatronics and precision measurement. The PDFs are the real certificates, and the AutoCAD one can be checked directly with Certiport.</p>
      </div>

      <ul class="card-grid xp-certs">
        {filedCerts.map((c) => (
          <li class="card card-hover xp-cert">
            <div class="xp-cert-top">
              <span class="badge badge-done">{c.date ? fmtDay(c.date) : 'Date to add'}</span>
            </div>
            <h3 class="card-title"><Icon name="award" />{c.name}</h3>
            <p class="muted small">{c.issuer}{c.issuerDetail && <>, {lower(c.issuerDetail)}</>}</p>
            <ul class="xp-bullets small">
              {c.covers.map((b) => <li>{b}</li>)}
            </ul>
            {c.verify && <p class="small muted">Verification code <strong class="xp-code">{c.verify.code}</strong></p>}
            <div class="actions xp-cert-links">
              <a class="button button-sm" href={c.file!} target="_blank" rel="noopener"><Icon name="file" />View certificate<span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
              {c.verify && (
                <a class="button button-outline button-sm" href={c.verify.url} target="_blank" rel="noopener">Verify<span class="visually-hidden"> on Certiport (opens in a new tab)</span></a>
              )}
            </div>
          </li>
        ))}
      </ul>

      <div class="xp-unfiled-head">
        <h3>Also earned</h3>
        <p class="muted small">These are listed on my resume. Their certificates aren't on the site yet.</p>
      </div>
      <ul class="card-grid xp-unfiled">
        {unfiledCerts.map((c) => (
          <li class="card xp-cert">
            <div class="xp-cert-top">
              <span class="badge">{c.date ? fmtDay(c.date) : 'Certificate coming'}</span>
            </div>
            <h4>{c.name}</h4>
            <p class="muted small">{c.issuer}</p>
            <p class="small">{c.covers.join('. ')}.</p>
            {c.todos && <p class="small"><span class="todo">Lucas: send {c.todos.join(' and ')}</span></p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="section section-tint" id="education" aria-labelledby="edu-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="edu-h">Education</h2>
      </div>
      <div class="card xp-edu">
        <div class="split">
          <div class="stack-md">
            <h3 class="card-title"><Icon name="graduation" />{education.school}</h3>
            <p class="muted small">{education.location}</p>
            <p>
              I'm in the {education.program} program, a hands-on vocational track: CAD, technical
              drawings, CNC, precision measurement and electronics, alongside regular academics.
            </p>
            <p><span class="todo">One or two favorite ET projects or classes, with what you made</span></p>
          </div>
          <div class="stack-md">
            <TitleBlock items={[
              { label: 'Program', value: education.program },
              { label: 'Years', value: `${education.start} to ${education.end}` },
              { label: 'GPA', value: education.gpa },
              { label: 'Class of', value: String(education.end) },
            ]} />
            <ul class="chips" aria-label="Activities">
              {education.activities.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="section" id="skills" aria-labelledby="skills-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="skills-h">Skills</h2>
        <p>Grouped by what kind of work they're for, with where I've actually used each group, so you can check.</p>
      </div>
      <ul class="card-grid xp-skills">
        {skillGroups.map((g) => (
          <li class="card stack-sm">
            <h3 class="card-title">{g.name}</h3>
            <ul class="chips">
              {g.skills.map((s) => <li>{s}</li>)}
            </ul>
            <p class="small muted">{g.usedOn}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STRENGTHS -->
  <section class="section section-tint" id="strengths" aria-labelledby="str-h">
    <div class="frame">
      <div class="section-head">
        <h2 id="str-h">Strengths</h2>
        <p>Anyone can list these, so here's the evidence for each one.</p>
      </div>
      <ul class="card-grid xp-strengths">
        {strengths.map((s) => (
          <li class="card stack-sm">
            <h3 class="card-title"><Icon name="spark" />{s.name}</h3>
            <p class="muted">{s.proof}</p>
          </li>
        ))}
      </ul>
      <p class="small muted xp-sports">Outside of all this: {sports.join('; ').toLowerCase()}.</p>
    </div>
  </section>

  <!-- RESUME REQUEST -->
  <section class="section" aria-labelledby="cta-h">
    <div class="frame">
      <div class="card xp-cta stack-md">
        <h2 id="cta-h">Want the one-page version?</h2>
        <p class="muted">I send my resume by email so it's always the current one. References are available on request.</p>
        <div class="actions xp-cta-actions">
          <a class="button" href={resumeHref}><Icon name="mail" />Request my resume</a>
          <a class="button button-outline" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
