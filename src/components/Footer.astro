---
import Icon from './Icon.astro'
import { site } from '../data/site'
const updated = new Date(site.updated).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
---
<footer class="site-footer">
  <div class="frame">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name"><span class="brand-mark" aria-hidden="true">LB</span>Lucas Bianco</p>
        <p>{site.program} student at {site.schoolShort}, class of {site.classOf}. Co-op on Dell's Process Development team. Looking for engineering internships and co-ops.</p>
        <p>Based in {site.region}. <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <div class="footer-social">
          <a class="icon-button" href={site.github} aria-label="GitHub"><Icon name="github" /></a>
          <a class="icon-button" href={site.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a class="icon-button" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
          <a class="icon-button" href="/notes/rss.xml" aria-label="RSS feed for notes"><Icon name="rss" /></a>
        </div>
      </div>
      <div>
        <h2>Portfolio</h2>
        <ul>
          <li><a href="/#about">About</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#builds">CAD and builds</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>More</h2>
        <ul>
          <li><a href="/experience/">Full resume</a></li>
          <li><a href="/about/">My story</a></li>
          <li><a href="/timeline/">Timeline</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/notes/">Notes</a></li>
          <li><a href="/uses/">My setup</a></li>
        </ul>
      </div>
      <div>
        <h2>Connect</h2>
        <ul>
          <li><a href={`mailto:${site.email}?subject=Resume%20request`}>Request my resume</a></li>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.github}>GitHub</a></li>
          <li><a href="/experience/#certifications">Certifications</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Lucas Bianco. Updated {updated}.</p>
      <p><a href="#top">Back to top</a></p>
    </div>
  </div>
</footer>
