---
// Top of the secondary pages: optional breadcrumb, title, lede.
interface Props {
  title: string
  lede?: string
  measure?: string                     // small label under the title, e.g. "2021 to now"
  crumbs?: { href: string; label: string }[]
}
const { title, lede, measure, crumbs } = Astro.props
---
<header class="page-header">
  <div class="frame">
    {crumbs && (
      <p class="breadcrumb">{crumbs.map((c, i) => <>{i > 0 && ' / '}<a href={c.href}>{c.label}</a></>)}</p>
    )}
    <h1>{title}</h1>
    {measure && <p class="badge badge-accent page-measure">{measure}</p>}
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>
