---
// Project card for the home page and /projects/: photo, category + status badges,
// title, summary, tool chips, and a "View project" button.
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { categoryLabel, statusLabel } from '../data/labels'

interface Props { project: CollectionEntry<'projects'>; eager?: boolean }
const { project, eager = false } = Astro.props
const d = project.data
const statusClass = d.status === 'done' ? 'badge-done' : d.status === 'ongoing' ? 'badge-ongoing' : ''
---
<article class="card card-hover project-card" data-category={d.category}>
  <a class="card-media" href={`/projects/${project.id}/`} tabindex="-1" aria-hidden="true">
    <Image src={d.cover} alt="" widths={[400, 640, 900]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
  </a>
  <div class="project-card-badges">
    <span class="badge badge-accent">{categoryLabel[d.category]}</span>
    <span class:list={['badge', statusClass]}>{statusLabel[d.status]}</span>
  </div>
  <h3 class="project-card-title"><a href={`/projects/${project.id}/`}>{d.title}</a></h3>
  <p class="project-card-summary">{d.summary}</p>
  <ul class="chips">{d.tools.slice(0, 6).map((t) => <li>{t}</li>)}</ul>
  <a class="button button-outline button-block button-sm project-card-cta" href={`/projects/${project.id}/`}>View project<span class="visually-hidden">: {d.title}</span></a>
</article>
