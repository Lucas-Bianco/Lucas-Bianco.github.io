---
import { nav } from '../data/site'
const path = Astro.url.pathname
const isCurrent = (href: string) => path === href || path.startsWith(href)
---
<header class="site-header">
  <nav class="frame" aria-label="Main">
    <a class="brand" href="/">Lucas Bianco</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="tabs">Menu</button>
    <ul class="tabs" id="tabs">
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a class="button header-cta" href="/#contact">Contact</a>
  </nav>
</header>

<script>
  // Mobile menu: show/hide the tab list
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
  const tabs = document.getElementById('tabs')
  toggle?.addEventListener('click', () => {
    const open = tabs?.classList.toggle('open') ?? false
    toggle.setAttribute('aria-expanded', String(open))
    toggle.textContent = open ? 'Close' : 'Menu'
  })
</script>
