---
// A photo with a drawing-style caption: "Fig. 3  Drop test at NASA".
// src is an imported image (import x from '../assets/photos/...').
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  fig?: number | string
  bleed?: boolean        // full width, no rounded corners
  eager?: boolean        // true only for the first big photo on a page
  sizes?: string
}
const { src, alt, caption, fig, bleed = false, eager = false, sizes = bleed ? '100vw' : '(min-width: 760px) 44rem, 100vw' } = Astro.props
const candidates = bleed ? [640, 1024, 1600, 2000] : [400, 700, 1000, 1400]
const fits = candidates.filter((w) => w <= src.width)
const widths = fits.length ? fits : undefined
---
<figure class:list={['figure', bleed && 'figure-bleed']}>
  <Image src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} sizes={sizes} widths={widths} quality={78} />
  {(caption || fig) && (
    <figcaption>{fig && <span class="fig-no">Fig. {fig}</span>}{caption}</figcaption>
  )}
</figure>
